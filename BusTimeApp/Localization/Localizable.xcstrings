    "liveActivity.noDepartureTime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The departure time could not be confirmed, so the Live Activity cannot start."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出発時刻を確認できないため、Live Activityを開始できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认出发时间，因此无法启动实时活动。"
          }
        }
      }
    },
    "liveActivity.notPermitted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activities cannot start. Please allow Live Activities for BusTime in iPhone Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activityを開始できません。iPhoneの設定で、BusTimeのLive Activityを許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动实时活动。请在 iPhone 设置中允许 BusTime 使用实时活动。"
          }
        }
      }
    },
    "liveActivity.openSettings": {
      "extractionState": "manual",
