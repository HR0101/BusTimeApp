    "notify.onlyNormalNotification": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nA Live Activity for another service is showing, so only the standard alert was set."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n別の便をLive Activityで表示中のため、通常通知だけを設定しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n因正在显示其他班次的实时活动，仅设置了普通提醒。"
          }
        }
      }
    },
    "notify.pushBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ departs in %2$lld minutes.\n* Based on the published timetable. Delays and cancellations are not reflected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が、あと%2$lld分で出発します。\n※時刻表の予定です。遅延・運休は反映されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@将在%2$lld分钟后出发。\n※以时刻表为准，不反映延误和停运。"
          }
        }
      }
    },
    "notify.pushTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your bus is coming"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バスの時間をお知らせします"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为您提醒巴士时间"
          }
        }
      }
    },
    "notify.resultTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alert"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知設定"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
