    "liveActivity.alreadyDeparted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This service has already departed. Please choose another one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この便はすでに出発しています。別の便を選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该班次已经出发。请选择其他班次。"
          }
        }
      }
    },
    "liveActivity.alreadyShowing": {
      "extractionState": "manual",
      "localizations": {
