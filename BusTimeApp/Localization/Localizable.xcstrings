        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 设置中允许通知"
          }
        }
      }
    },
    "options.autoStartDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setting a standard alert also starts a Live Activity. Using the button below also sets a 5-minute alert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の通知を設定すると、Live Activityも自動で開始します。下のボタンから始める場合は5分前通知も一緒に設定します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置普通提醒时会自动启动实时活动。通过下方按钮启动时会同时设置提前5分钟的提醒。"
          }
        }
      }
    },
    "options.autoStartOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic display is off in the app settings. You can start it with the button below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの設定で自動表示がオフです。必要なときは下のボタンから開始できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在应用设置中关闭自动显示。需要时可通过下方按钮启动。"
          }
        }
      }
    },
