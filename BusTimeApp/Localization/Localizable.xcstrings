      }
    },
    "scheduleError.notPermitted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are not allowed. Please turn on notifications for “BusTime” in iPhone Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知が許可されていません。iPhoneの設定で「BusTime」の通知をオンにしてください。"
