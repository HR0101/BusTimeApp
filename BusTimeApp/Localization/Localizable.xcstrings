    "scheduleError.noDeparture": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The departure time could not be confirmed. Please choose another service."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バスの出発時刻を確認できませんでした。別の便を選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认巴士出发时间。请选择其他班次。"
          }
