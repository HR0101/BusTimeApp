          "stringUnit": {
            "state": "translated",
            "value": "只需在清晰易读的卡片上查看所需班次。"
          }
        }
      }
    },
    "tutorial.page1Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nicer way to\ncatch your bus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バスの時間を、\nもっと気持ちよく"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让乘车时间\n更加舒心"
          }
        }
      }
    },
    "tutorial.page2Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a route and a time to find your next bus."
