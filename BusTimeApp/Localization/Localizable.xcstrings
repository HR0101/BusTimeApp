    "notify.scheduledMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alert is set.\n\n%1$@\nYou will be notified %2$@.%3$@\n\n* Based on the published timetable. Delays and cancellations are not reflected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を設定しました。\n\n%1$@\n%2$@にお知らせします。%3$@\n\n※時刻表の予定です。遅延・運休は反映されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已设置提醒。\n\n%1$@\n将于%2$@通知您。%3$@\n\n※以时刻表为准，不反映延误和停运。"
          }
        }
      }
    },
    "notify.unavailableOtherDay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are times for another weekday. Please set the alert on the day of travel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の平日の時刻のため、通知は運行当日に設定してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是其他工作日的时刻，请在乘车当天设置提醒。"
          }
        }
      }
    },
    "notify.unavailableSuspended": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No service today, so alerts cannot be set. You can set them on a weekday."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運休日のため通知は設定できません。平日になると設定できます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日停运，无法设置提醒。工作日可以设置。"
          }
        }
      }
    },
    "options.allowInSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications in iPhone Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneの設定で通知を許可する"
          }
