    "scheduleError.tooLate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alert time for this service has already passed. Please choose a later service."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この便は通知時刻がすでに過ぎています。もう少し先の便を選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该班次的提醒时间已过。请选择更晚的班次。"
          }
