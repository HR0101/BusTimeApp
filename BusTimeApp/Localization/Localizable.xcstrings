    "settings.appearanceDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The background shifts slowly from a bright morning sky to sunset and then a starry night. The sun and moon move with the current time too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝は明るい空、夕方は夕焼け、夜は星空へと背景がゆっくり変化します。太陽と月の位置も現在時刻に合わせて動きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景会从明亮的清晨天空缓缓变为晚霞，再变为星空。太阳和月亮的位置也随当前时间移动。"
          }
        }
      }
    },
