    "liveActivity.otherBusShowing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Live Activity for another service is showing. Please end it from “Scheduled alerts” first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の便のLive Activityを表示中です。先に「設定した通知」から表示を終了してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在显示其他班次的实时活动。请先从“已设置的提醒”结束显示。"
          }
        }
      }
    },
    "liveActivity.startFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Live Activity could not start. Please check iPhone Settings and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activityを開始できませんでした。iPhoneの設定を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动实时活动。请检查 iPhone 设置后重试。"
          }
        }
      }
    },
