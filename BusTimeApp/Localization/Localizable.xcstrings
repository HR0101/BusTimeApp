    "tutorial.page1Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See just the services you need on clear, readable cards."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要な便だけを、見やすいカードで確認できます。"
          }
